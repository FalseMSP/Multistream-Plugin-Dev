// ClipCurator Prisma schema
// SQLite is used for the sandbox environment (PostgreSQL in production per spec)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("REVIEWER") // ADMIN | REVIEWER
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clips     Clip[]
  streams   StreamSource[]
}

model StreamSource {
  id            String   @id @default(cuid())
  url           String
  platform      String   // TWITCH | YOUTUBE
  title         String?
  streamerName  String?
  durationSec   Int?
  downloadedAt  DateTime?
  status        String   @default("PENDING") // PENDING | DOWNLOADING | ANALYZING | READY | FAILED
  storagePath   String?  // /vods/{id}/master.mp4 — served by clipper
  errorMessage  String?
  progress      Int      @default(0) // 0-100
  clipCount     Int      @default(0)
  submittedById String?
  submitter     User?    @relation(fields: [submittedById], references: [id])
  clips         Clip[]

  // Raw Whisper transcript JSON — full segment list from analyze step.
  // The subtitle editor fetches this and filters to the clip's time range.
  // Stored as JSON string: [{start, end, text}, ...]
  transcriptJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clip {
  id              String   @id @default(cuid())
  sourceId        String
  source          StreamSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Timing (seconds)
  startTimeSec    Float
  endTimeSec      Float
  suggestedStart  Float
  suggestedEnd    Float

  // Review state
  status          String   @default("PENDING") // PENDING | IN_REVIEW | APPROVED_A | APPROVED_B | REJECTED | PUBLISHING | PUBLISHED | FAILED | RENDERED
  reviewerId      String?
  reviewer        User?    @relation(fields: [reviewerId], references: [id])
  reviewedAt      DateTime?

  // Final output
  finalStartSec   Float?
  finalEndSec     Float?
  storagePath     String?  // /clips/{id}/final.mp4 — served by clipper
  youtubeVideoId  String?
  publishedToChannelId String? // CHANNEL_A | CHANNEL_B
  publishedToChannel   Channel? @relation(fields: [publishedToChannelId], references: [id])
  publishedAt     DateTime?

  // Metadata
  engagementScore Float    @default(0) // 0.0 - 1.0
  transcript      String?
  chatVelocity    Int?     // msgs/sec at peak
  thumbnailUrl    String?
  peakPhrase      String?

  // ─── Post-processing options (set during review) ────────────────────────
  // Subtitles — when true, FFmpeg burns in VTT subtitles during render.
  withSubtitles   Boolean  @default(false)
  // WebVTT content for the clip (edited by user, defaults to Whisper output).
  subtitleVtt     String?
  // Subtitle styling — JSON string: {fontSize, color, bgColor, position, fontFamily}
  subtitleStyle   String?

  // Backing track — when true, FFmpeg mixes in the selected backing track.
  withBackingTrack Boolean @default(false)
  // Volume of backing track (0.0-1.0). Original audio is always 1.0.
  backingTrackVolume Float @default(0.3)
  backingTrackId  String?
  backingTrack    BackingTrack? @relation(fields: [backingTrackId], references: [id], onDelete: SetNull)

  // Retry tracking
  publishAttempts Int      @default(0)
  errorMessage    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Channel {
  // id is "CHANNEL_A" or "CHANNEL_B" — fixed, not auto-generated.
  id                  String   @id
  label               String   @default("Channel A") // user-editable display name
  youtubeChannelId    String?  // fetched from YouTube API after OAuth
  youtubeChannelName  String?
  youtubeChannelAvatar String?
  // Path to OAuth tokens file (relative to project root). Defaults:
  //   CHANNEL_A → .youtube-tokens.json
  //   CHANNEL_B → .youtube-tokens-b.json
  tokenFilePath      String
  isConfigured       Boolean  @default(false) // true once tokens exist + YouTube API confirms
  clips              Clip[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BackingTrack {
  id          String   @id @default(cuid())
  name        String   // user-provided label, e.g. "Lofi Beat"
  storagePath String   // /backing/{id}.mp3 — served by clipper
  fileSizeBytes Int?
  durationSec Float?
  createdAt   DateTime @default(now())
  clips       Clip[]
}

model JobLog {
  id          String   @id @default(cuid())
  sourceId    String?
  clipId      String?
  jobType     String   // download-vod | analyze-stream | render-final-clip | publish-to-youtube
  status      String   @default("QUEUED") // QUEUED | ACTIVE | COMPLETED | FAILED
  progress    Int      @default(0)
  payload     String?  // JSON string
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
