# Add these models to the END of your existing prisma/schema.prisma

model TwitchChannel {
  id            String   @id @default(cuid())
  channelName   String   @unique
  displayName   String?
  isLive        Boolean  @default(false)
  autoIngest    Boolean  @default(true)
  lastChecked   DateTime @default(now())
  lastIngestedAt DateTime?
  lastVodUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClipReviewFeedback {
  id              String   @id @default(cuid())
  clipId          String
  sourceId        String
  label           Int      // 0=accept, 1=reject_bad, 2=not_interested
  engagementScore Float
  features        String   // JSON
  channel         String?
  // YouTube analytics feedback
  retentionScore  Float?   // average view percentage (0-1)
  openingRetention Float?  // retention at first 10% of video
  viewCount       Int?
  likeCount       Int?
  fetchedAt       DateTime?
  createdAt       DateTime @default(now())
}
