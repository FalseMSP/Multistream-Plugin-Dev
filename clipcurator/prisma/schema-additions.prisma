# Add these models to the END of your existing prisma/schema.prisma

model TwitchChannel {
  id            String   @id @default(cuid())
  channelName   String   @unique  // lowercase Twitch username
  displayName   String?             // original case display name
  isLive        Boolean  @default(false)
  autoIngest    Boolean  @default(true)  // auto-download VOD when stream ends
  lastChecked   DateTime @default(now())
  lastIngestedAt DateTime?
  lastVodUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClipReviewFeedback {
  id              String   @id @default(cuid())
  clipId          String
  sourceId        String
  accepted        Boolean  // true = published, false = rejected
  engagementScore Float
  features        String   // JSON: {chatVelocity, audioScore, textScore, ...}
  channel         String?  // CHANNEL_A or CHANNEL_B (null if rejected)
  createdAt       DateTime @default(now())
}
