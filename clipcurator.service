[Unit]
Description=ClipCurator — Next.js clip management UI + clipper backend

After=network-online.target chat-mirror.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/discord-chat-mirror2

# Load NVM and Python so node/npx/python are available
Environment=NVM_DIR=/home/ubuntu/.nvm
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.14.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLIPPER_PORT=8100
Environment=CLIPCURATOR_PORT=3001

# Kill stale processes on ports 8100 and 3001 before starting
ExecStartPre=/usr/bin/bash -c 'for port in 8100 3001; do pid=$(lsof -ti :$port 2>/dev/null); [ -n "$pid" ] && kill $pid 2>/dev/null || true; done; sleep 1'

# Start ClipCurator and clipper using the startup script
ExecStart=/home/ubuntu/.nvm/versions/node/v24.14.1/bin/bash /home/ubuntu/discord-chat-mirror2/start-clipcurator.sh

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clipcurator

[Install]
WantedBy=multi-user.target
